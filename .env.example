# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Amazon SP-API, Amazon.co.uk (Login with Amazon app credentials) ----------------
# From Seller Central > Apps & Services > Develop Apps > your app > "View" LWA credentials.
SPAPI_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPAPI_LWA_CLIENT_SECRET=replace-me
# Refresh token from authorising the app for the UK (Europe) selling account.
# The app must have the "Brand Analytics" role and the brand must be registered in the UK.
SPAPI_LWA_REFRESH_TOKEN=Atzr|replace-me
# Amazon.co.uk. The EU endpoint (sellingpartnerapi-eu.amazon.com) follows from it.
SPAPI_MARKETPLACE_ID=A1F83G8C2ARO7P
# Optional: overrides the regional endpoint derived from the marketplace.
# SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# AWS IAM keys / SigV4 signing are NOT needed: SP-API has accepted LWA-only
# requests since October 2023.

# --- MySQL ---------------------------------------------------------------------------
# POWERBI_DB_HOST/_PORT/_USER/_PASSWORD/_NAME (the amazon_daily_data names) work too.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_NAME=powerbidb
# The UK table. The US table 2024BrandAnalytics is refused.
DB_TABLE=brandanalytics_uk

# --- Behaviour -----------------------------------------------------------------------
# Unique ASINs in config/asins.txt.
EXPECTED_ASIN_COUNT=139
# Timezone used to decide which SQP week is the latest completed one.
SQP_TIMEZONE=Europe/London
# Days after a week ends (Saturday) before it counts as available: 2 = from Monday (UK time).
SQP_AVAILABILITY_LAG_DAYS=2
# The only currency the table's prices may be in.
SQP_CURRENCY=GBP
# How often and how long one run waits for Amazon (the queue can take a day): 5 min, 22 h.
SQP_POLL_INTERVAL_SECONDS=300
SQP_POLL_TIMEOUT_SECONDS=79200
SQP_MAX_RETRIES=6
LOG_LEVEL=INFO
# Optional: move data/ (raw reports, state) or logs/ elsewhere.
# SQP_DATA_DIR=/data/cron/amazon-sqp-weekly-updater-uk/data
# SQP_LOG_DIR=/data/cron/amazon-sqp-weekly-updater-uk/logs
